# Copy to .env and fill in. Never commit .env.

# Database (docker compose default)
DATABASE_URL="postgresql://metahr:metahr@localhost:5432/metahr?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Only work emails on this domain can sign in
ALLOWED_EMAIL_DOMAIN="themetadatum.com"

# Google Workspace SSO (optional in dev; the button is hidden when unset)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic-link email (Mailpit in dev: http://localhost:8025)
EMAIL_SERVER="smtp://localhost:1025"
EMAIL_FROM="metadatum People <people@themetadatum.com>"

# Field-level encryption for statutory/bank data.
# Format "v<n>:<base64 32 bytes>"; comma-separate to keep old keys for decryption, newest first.
# generate: node -e "console.log('v1:'+require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=""
# HMAC key for searchable/duplicate-check hashes (base64 32 bytes)
BLIND_INDEX_KEY=""

# File storage: "local" (dev) or "s3"
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Protects /api/cron/* (scheduled jobs)
CRON_SECRET=""
